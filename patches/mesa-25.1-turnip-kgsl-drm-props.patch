+   /* Downstream msm (e.g. Surface Duo, msm-4.14): the display is a separate DRM
+    * device (msm_drm/SDE) while the GPU is driven through kgsl. Expose that DRM
+    * node's ids via VK_EXT_physical_device_drm so wlroots, GBM and Zink can match
+    * this physical device to the display's render node. */
+   {
+      const char *rnode = getenv("TU_KGSL_DRM_RENDER_NODE");
+      const char *pnode = getenv("TU_KGSL_DRM_PRIMARY_NODE");
+      struct stat st;
+      if (!rnode) rnode = "/dev/dri/renderD128";
+      if (!pnode) pnode = "/dev/dri/card0";
+      if (stat(rnode, &st) == 0 && S_ISCHR(st.st_mode)) {
+         device->has_local = true;
+         device->local_major = major(st.st_rdev);
+         device->local_minor = minor(st.st_rdev);
+      }
+      if (stat(pnode, &st) == 0 && S_ISCHR(st.st_mode)) {
+         device->has_master = true;
+         device->master_major = major(st.st_rdev);
+         device->master_minor = minor(st.st_rdev);
+      }
+   }
