+static gboolean
+hinge_angle_close_cb (SSCSensorHingeAngle *self)
+{
+	g_autoptr (GError) err = NULL;
+	if (!ssc_sensor_hinge_angle_close_sync (self, NULL, &err))
+		g_printf ("Unable to close hinge angle sensor: %s\n", err ? err->message : "UNKNOWN");
+	g_debug ("Hinge angle sensor disabled");
+	exit(0);
+	return G_SOURCE_REMOVE;
+}
+
+static void hinge_angle_measurement (SSCSensorHingeAngle *sensor, gfloat angle, gpointer user_data)
+{
+	g_printf ("Hinge angle sensor measurement: %.1f deg\n", angle);
+	fflush(stdout);
+}
+
+static gboolean
+hall_close_cb (SSCSensorHall *self)
+{
+	g_autoptr (GError) err = NULL;
+	if (!ssc_sensor_hall_close_sync (self, NULL, &err))
+		g_printf ("Unable to close hall sensor: %s\n", err ? err->message : "UNKNOWN");
+	g_debug ("Hall sensor disabled");
+	exit(0);
+	return G_SOURCE_REMOVE;
+}
+
+static void hall_measurement (SSCSensorHall *sensor, gboolean near, gpointer user_data)
+{
+	g_printf ("Hall sensor measurement: %s\n", near ? "NEAR" : "FAR");
+	fflush(stdout);
+}
+
