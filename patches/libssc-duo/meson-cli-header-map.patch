+static const char *posture_name (gint state)
+{
+	switch (state) {
+	case 0: return "CLOSED";
+	case 1: return "PEEK_RIGHT";
+	case 2: return "PEEK_LEFT";
+	case 3: return "READ";
+	case 4: return "COMPOSE";
+	case 5: return "OPEN_DUAL_PORTRAIT";
+	case 6: return "OPEN_DUAL_LANDSCAPE";
+	case 7: return "BROCHURE_RIGHT";
+	case 8: return "TENT_RIGHT";
+	case 9: return "FLIP_P_RIGHT";
+	case 10: return "FLIP_L_RIGHT";
+	case 11: return "FLIP_P_LEFT";
+	case 12: return "FLIP_L_LEFT";
+	case 13: return "BROCHURE_LEFT";
+	case 14: return "TENT_LEFT";
+	case 15: return "RAMP_RIGHT";
+	case 16: return "RAMP_LEFT";
+	case 99: return "UNDETERMINED";
+	default: return "UNKNOWN";
+	}
+}
+
+static gboolean
+posture_close_cb (SSCSensorPosture *self)
+{
+	g_autoptr (GError) err = NULL;
+	if (!ssc_sensor_posture_close_sync (self, NULL, &err))
+		g_printf ("Unable to close posture sensor: %s\n", err ? err->message : "UNKNOWN");
+	g_debug ("Posture sensor disabled");
+	exit(0);
+	return G_SOURCE_REMOVE;
+}
+
+static void posture_measurement (SSCSensorPosture *sensor, gint state, gpointer user_data)
+{
+	g_printf ("Posture sensor measurement: %d %s\n", state, posture_name (state));
+	fflush(stdout);
+}
+
+static gboolean
+hinge_angle_close_cb (SSCSensorHingeAngle *self)
+{
+	g_autoptr (GError) err = NULL;
+	if (!ssc_sensor_hinge_angle_close_sync (self, NULL, &err))
+		g_printf ("Unable to close hinge angle sensor: %s\n", err ? err->message : "UNKNOWN");
+	g_debug ("Hinge angle sensor disabled");
+	exit(0);
+	return G_SOURCE_REMOVE;
+}
+
+static void hinge_angle_measurement (SSCSensorHingeAngle *sensor, gfloat angle, gpointer user_data)
+{
+	g_printf ("Hinge angle sensor measurement: %.1f deg\n", angle);
+	fflush(stdout);
+}
+
+static gboolean
+hall_close_cb (SSCSensorHall *self)
+{
+	g_autoptr (GError) err = NULL;
+	if (!ssc_sensor_hall_close_sync (self, NULL, &err))
+		g_printf ("Unable to close hall sensor: %s\n", err ? err->message : "UNKNOWN");
+	g_debug ("Hall sensor disabled");
+	exit(0);
+	return G_SOURCE_REMOVE;
+}
+
+static void hall_measurement (SSCSensorHall *sensor, gboolean near, gpointer user_data)
+{
+	g_printf ("Hall sensor measurement: %s\n", near ? "NEAR" : "FAR");
+	fflush(stdout);
+}
+
