// Matrix base input defaults (absorbed from zdots input.kdl).
input {
    keyboard {
        xkb {}
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "adaptive"
        click-method "clickfinger"
    }

    mouse {
        accel-profile "flat"
    }

    trackpoint {}
}

clipboard {
    disable-primary
}
