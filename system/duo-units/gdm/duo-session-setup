#!/bin/bash
# Beim Start der GNOME-Sitzung (XDG-Autostart): Touch-Zuordnung je Panel als BENUTZERWERT, Lautstaerke 15 %.
S=org.gnome.desktop.peripherals.touchscreen:/org/gnome/desktop/peripherals/touchscreens
gsettings set $S/045e:0c01/ output "['QCM', '0x0001', '0x00000001', 'DSI-1']" 2>/dev/null
gsettings set $S/045e:0c02/ output "['QCM', '0x0001', '0x00000001', 'DSI-2']" 2>/dev/null
# Schutz: Stirbt die Shell in den ersten 60 s (z. B. gdm-Neustart), setzt GNOME disable-user-extensions=true; hier zuruecknehmen.
gsettings set org.gnome.shell disable-user-extensions false 2>/dev/null
sleep 5; wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.4 2>/dev/null
